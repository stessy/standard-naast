    <changeSet id="014-1-fk-saison-equipe" author="standardnaast">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="FK_SAISON_EQUIPE_SAISON"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseTableName="SAISON_EQUIPE" baseColumnNames="SAISON_ID"
                                 referencedTableName="SAISON" referencedColumnNames="SAISON_ID"
                                 constraintName="FK_SAISON_EQUIPE_SAISON"/>
        <addForeignKeyConstraint baseTableName="SAISON_EQUIPE" baseColumnNames="EQUIPE_ID"
                                 referencedTableName="EQUIPE" referencedColumnNames="EQUIPE_ID"
                                 constraintName="FK_SAISON_EQUIPE_EQUIPE"/>
