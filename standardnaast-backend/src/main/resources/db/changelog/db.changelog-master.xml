<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 1. Initial complete schema (tables & sequences) -->
    <changeSet id="000-initial-schema" author="standardnaast">
        <sqlFile path="liquibaseChangelog/000_initial_schema.sql"
                 relativeToChangelogFile="true"
                 splitStatements="true"
                 stripComments="true"/>
    </changeSet>

    <!-- 2. Security and Users -->
    <include file="liquibaseChangelog/013_users_and_roles.xml" relativeToChangelogFile="true"/>

    <!--&lt;!&ndash; 3. Initial / Migrated Data from H2 (executed once on fresh installation) &ndash;&gt;
    <changeSet id="099-initial-data" author="standardnaast">
        <preConditions onFail="MARK_RAN">
            <tableIsEmpty tableName="PERSONNES"/>
        </preConditions>
        <sqlFile path="liquibaseChangelog/099_initial_data.sql"
                 relativeToChangelogFile="true"
                 splitStatements="true"
                 stripComments="true"/>
    </changeSet>

    &lt;!&ndash; 4. Foreign Key Constraints &ndash;&gt;
    <include file="liquibaseChangelog/014_foreign_keys.xml" relativeToChangelogFile="true"/>

    &lt;!&ndash; 5. PostgreSQL Sequence Synchronization &ndash;&gt;
    <include file="liquibaseChangelog/015_sync_sequences.xml" relativeToChangelogFile="true"/>-->

</databaseChangeLog>
