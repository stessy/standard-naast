{
  "name": "standardnaast-desktop",
  "version": "1.0.0",
  "description": "Application Desktop Standard de Naast (Spring Boot + Angular + PostgreSQL)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "migrate:h2": "node scripts/migrate-h2.js",
    "download:binaries": "node scripts/download-binaries.js",
    "download:binaries:all": "node scripts/download-binaries.js --all",
    "download:binaries:mac": "node scripts/download-binaries.js --platform=darwin-arm64",
    "download:binaries:win": "node scripts/download-binaries.js --platform=win32-x64",
    "build:prepare": "node scripts/prepare-resources.js",
    "predist": "npm run build:prepare",
    "predist:mac": "npm run build:prepare -- --platform=darwin-arm64",
    "predist:mac:universal": "npm run build:prepare -- --all",
    "predist:win": "npm run build:prepare -- --platform=win32-x64",
    "predist:all": "npm run build:prepare -- --all",
    "dist": "npm run build:prepare && electron-builder",
    "dist:mac": "npm run build:prepare -- --platform=darwin-arm64 && electron-builder --mac dmg --arm64",
    "dist:mac:universal": "npm run build:prepare -- --all && electron-builder --mac dmg --universal",
    "dist:win": "npm run build:prepare -- --platform=win32-x64 && electron-builder --win nsis --x64",
    "dist:all": "npm run build:prepare -- --all && electron-builder -mw",
    "build:mac": "npm run dist:mac",
    "build:win": "npm run dist:win",
    "build:all": "npm run dist:all"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "be.standardnaast.desktop",
    "productName": "Standard de Naast",
    "copyright": "Copyright © 2026 Standard de Naast",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "main.js",
      "splash.html",
      "ui/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/jre/${os}-${arch}",
        "to": "jre",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/postgres/${os}-${arch}",
        "to": "postgres",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.sports",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Standard de Naast",
      "uninstallDisplayName": "Standard de Naast"
    }
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "electron-winstaller@5.4.0": true
  }
}
